NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace_with_64_plus_random_chars
JWT_REFRESH_SECRET=replace_with_a_different_64_plus_random_chars
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=30d
COOKIE_SECURE=false
TRUST_PROXY=false

PERSISTENCE_ENABLED=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hms_db
DB_USER=hms_user
DB_PASSWORD=hms_password
DB_SSL=false
# DATABASE_URL=postgresql://hms_user:hms_password@localhost:5432/hms_db

# Production note:
# 1. Create the DB/user on PostgreSQL first.
# 2. Generate strong JWT secrets and keep them out of git.
# 3. Run `npm run db:setup` from the project root to apply schema + seed hospital masters.
# 4. Keep PERSISTENCE_ENABLED=true for real hospital usage.
# 5. Run `npm run check:deployment` before go-live.

DEMO_ADMIN_EMAIL=admin@sraiims.in
DEMO_ADMIN_PASSWORD=Admin@123

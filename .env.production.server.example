# Copy this file to `.env.production.server` on the server and fill in real secrets.
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://hms.example.org

PERSISTENCE_ENABLED=true
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=hms_db
DB_USER=hms_user
DB_PASSWORD=replace_with_server_db_password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_TIMEOUT_MS=5000

JWT_ACCESS_SECRET=replace_with_64_plus_random_chars
JWT_REFRESH_SECRET=replace_with_a_different_64_plus_random_chars
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=30d
JWT_ISSUER=sr-aiims-hms
JWT_AUDIENCE=sr-aiims-hms-web
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY=true
OTP_DELIVERY_MODE=disabled

# Used once by `npm run db:bootstrap-admin`, then remove the password value.
INITIAL_ADMIN_EMAIL=admin@sraiims.in
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_14_plus_character_password
INITIAL_ADMIN_NAME=HMS Administrator
INITIAL_ADMIN_EMPLOYEE_ID=SRA-ADMIN-001

# Keep blank when the UI and API are served through the same Nginx origin.
VITE_API_BASE_URL=
